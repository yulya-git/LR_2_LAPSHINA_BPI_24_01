<Window x:Class="LR_2_LAPSHINA_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR_2_LAPSHINA_BPI_24_01"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="500"><ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>

        <!-- ==================== Формула 1 ==================== -->
        <RadioButton x:Name="Radio1" Margin="5"
                         GroupName="FormulaGroup" IsChecked="True">
            <WrapPanel>
                <Image x:Name="Img1" Height="50"/>
                <GroupBox Header="Parameters">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <Label Content="a" Grid.Row="0" Grid.Column="0"/>
                        <TextBox x:Name="R1TextA" Text="0"
                                     Grid.Row="0" Grid.Column="1" MinWidth="70"/>

                        <Label Content="f" Grid.Row="1" Grid.Column="0"/>
                        <ComboBox x:Name="R1ComboF" Grid.Row="1" Grid.Column="1"
                                      SelectedIndex="0">
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                            <ComboBoxItem Content="9"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>
            </WrapPanel>
        </RadioButton>

        <!-- ==================== Формула 2 ==================== -->
        <RadioButton x:Name="Radio2" Margin="5" GroupName="FormulaGroup">
            <StackPanel>
                <Image x:Name="Img2" Height="30"/>
                <GroupBox Header="Parameters">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="a"/>
                        <TextBox x:Name="R2TextA" Text="0" MinWidth="60"/>
                        <Label Content="b"/>
                        <TextBox x:Name="R2TextB" Text="0" MinWidth="60"/>
                        <Label Content="f"/>
                        <ComboBox x:Name="R2ComboF" MinWidth="100" SelectedIndex="0">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="40"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </RadioButton>

        <!-- ==================== Формула 3 ==================== -->
        <RadioButton x:Name="Radio3" Margin="5" GroupName="FormulaGroup">
            <StackPanel>
                <Image x:Name="Img3" Height="40"/>
                <GroupBox Header="Parameters">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="a"/>
                        <TextBox x:Name="R3TextA" Text="0" MinWidth="50"/>
                        <Label Content="b"/>
                        <TextBox x:Name="R3TextB" Text="0" MinWidth="50"/>
                        <Label Content="c"/>
                        <ComboBox x:Name="R3ComboC" MinWidth="50" SelectedIndex="0">
                            <ComboBoxItem Content="0"/>
                            <ComboBoxItem Content="1"/>
                        </ComboBox>
                        <Label Content="d"/>
                        <ComboBox x:Name="R3ComboD" MinWidth="50" SelectedIndex="0">
                            <ComboBoxItem Content="-1"/>
                            <ComboBoxItem Content="0"/>
                            <ComboBoxItem Content="1"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </RadioButton>

        <!-- ==================== Формула 4 ==================== -->
        <RadioButton x:Name="Radio4" Margin="5" GroupName="FormulaGroup">
            <WrapPanel>
                <Image x:Name="Img4" Height="60"/>
                <GroupBox Header="Parameters">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="d"/>
                        <TextBox x:Name="R4TextD" Text="0" MinWidth="50"/>
                        <Label Content="a"/>
                        <TextBox x:Name="R4TextA" Text="0" MinWidth="50"/>
                        <Label Content="c"/>
                        <ComboBox x:Name="R4ComboC" MinWidth="50" SelectedIndex="0">
                            <ComboBoxItem Content="0"/>
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </RadioButton>

        <!-- ==================== Формула 5 (вариант 6) ==================== -->
        <RadioButton x:Name="Radio5" Margin="5" GroupName="FormulaGroup">
            <WrapPanel>
                <Image x:Name="Img5" Height="60"/>
                <GroupBox Header="Parameters (вариант 6)">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="x"/>
                        <TextBox x:Name="R5TextX" Text="0,5" MinWidth="50"/>
                        <Label Content="y"/>
                        <TextBox x:Name="R5TextY" Text="0,5" MinWidth="50"/>
                        <Label Content="N"/>
                        <ComboBox x:Name="R5TextN" MinWidth="50" SelectedIndex="0">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>
                        <Label Content="K"/>
                        <ComboBox x:Name="R5TextK" MinWidth="50" SelectedIndex="0">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>                       
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </RadioButton>

        <!-- ==================== Ответ ==================== -->
        <TextBox Text="Ответ: " x:Name="resultBox"
                     IsReadOnly="True" Margin="5"/>

        <!-- ==================== Кнопка ==================== -->
        <Button Content="Считать" Width="100" Margin="5"
                    x:Name="BtnCalc" Click="Calc_Click"/>
    </StackPanel>
</ScrollViewer>
</Window> 